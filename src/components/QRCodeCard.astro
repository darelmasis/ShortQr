---
import Button from './Button.astro'
---

<div class="qr-card">
  <div class="qr-card__box">
    <canvas class="qr-card__canvas" data-qr-canvas role="img" aria-label="Código QR del enlace"
    ></canvas>
  </div>

  <div class="qr-card__actions">
    <Button class="qr-card__copy" variant="secondary" data-copy-png aria-label="Copiar QR como PNG">
      <span class="copy-icon">
        <svg class="copy-icon__base" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="copy-icon__ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <svg class="copy-icon__err" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </span>
      <span>Copiar PNG</span>
      <span class="sr-only" data-copy-png-status aria-live="polite"></span>
    </Button>

    <Button class="qr-card__copy" variant="secondary" data-copy-svg aria-label="Copiar QR como SVG">
      <span class="copy-icon">
        <svg class="copy-icon__base" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="copy-icon__ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <svg class="copy-icon__err" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </span>
      <span>Copiar SVG</span>
      <span class="sr-only" data-copy-svg-status aria-live="polite"></span>
    </Button>
  </div>
</div>

<script>
  import QRCode from 'qrcode'

  interface QrOptions {
    mode: 'short' | 'direct'
  }

  interface QrPayload {
    shortUrl: string
    slug: string
    qrOptions?: QrOptions
  }

  const DISPLAY_PX = 300
  const PNG_PX = 1024
  const QR_MARGIN = 2
  const QR_COLOR = '#171717'

  const canvas = document.querySelector<HTMLCanvasElement>('[data-qr-canvas]')
  let current: QrPayload | null = null

  function renderQr(text: string, pixelSize: number): HTMLCanvasElement {
    const qr = QRCode.create(text, { errorCorrectionLevel: 'L' })

    const modules = qr.modules.size
    const unit = Math.floor(pixelSize / (modules + QR_MARGIN * 2))
    const size = unit * (modules + QR_MARGIN * 2)

    const target = document.createElement('canvas')
    target.width = size
    target.height = size

    const ctx = target.getContext('2d')
    if (!ctx) return target

    ctx.fillStyle = '#ffffff'
    ctx.fillRect(0, 0, size, size)
    ctx.fillStyle = QR_COLOR

    for (let row = 0; row < modules; row++) {
      for (let col = 0; col < modules; col++) {
        if (qr.modules.get(row, col)) {
          ctx.fillRect((col + QR_MARGIN) * unit, (row + QR_MARGIN) * unit, unit, unit)
        }
      }
    }

    return target
  }

  function renderSvg(text: string): string {
    const qr = QRCode.create(text, { errorCorrectionLevel: 'L' })

    const modules = qr.modules.size
    const total = modules + QR_MARGIN * 2
    let cells = ''
    for (let row = 0; row < modules; row++) {
      for (let col = 0; col < modules; col++) {
        if (qr.modules.get(row, col)) {
          cells += `<rect x="${col + QR_MARGIN}" y="${row + QR_MARGIN}" width="1" height="1"/>`
        }
      }
    }

    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${total} ${total}" shape-rendering="crispEdges"><rect width="100%" height="100%" fill="#ffffff"/><g fill="${QR_COLOR}">${cells}</g></svg>`
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text)
        return true
      }
    } catch {}
    try {
      const textarea = document.createElement('textarea')
      textarea.value = text
      textarea.setAttribute('readonly', '')
      textarea.style.position = 'fixed'
      textarea.style.opacity = '0'
      document.body.appendChild(textarea)
      textarea.select()
      const ok = document.execCommand('copy')
      textarea.remove()
      return ok
    } catch {
      return false
    }
  }

  async function copyImage(blob: Blob): Promise<boolean> {
    try {
      if (navigator.clipboard && typeof ClipboardItem !== 'undefined') {
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })])
        return true
      }
    } catch {}
    return false
  }

  function setState(button: HTMLButtonElement | null, status: HTMLElement | null, state: 'idle' | 'ok' | 'err'): void {
    if (!button) return
    button.classList.toggle('copy-icon--ok', state === 'ok')
    button.classList.toggle('copy-icon--err', state === 'err')
    if (status) {
      status.textContent =
        state === 'ok' ? 'QR copiado' : state === 'err' ? 'No se pudo copiar' : ''
    }
  }

  window.addEventListener('shortqr:render', (event) => {
    const payload = (event as CustomEvent<QrPayload>).detail
    current = payload

    if (!canvas) return
    const rendered = renderQr(payload.shortUrl, DISPLAY_PX)
    canvas.width = rendered.width
    canvas.height = rendered.height
    canvas.getContext('2d')?.drawImage(rendered, 0, 0)
  })

  document.querySelector('[data-copy-png]')?.addEventListener('click', () => {
    if (!current) return
    const button = document.querySelector<HTMLButtonElement>('[data-copy-png]')
    const status = document.querySelector<HTMLElement>('[data-copy-png-status]')
    const rendered = renderQr(current.shortUrl, PNG_PX)
    rendered.toBlob(async (blob) => {
      if (!blob) {
        setState(button, status, 'err')
        return
      }
      const ok = await copyImage(blob)
      setState(button, status, ok ? 'ok' : 'err')
      window.setTimeout(() => setState(button, status, 'idle'), 2000)
    }, 'image/png')
  })

  document.querySelector('[data-copy-svg]')?.addEventListener('click', () => {
    if (!current) return
    const button = document.querySelector<HTMLButtonElement>('[data-copy-svg]')
    const status = document.querySelector<HTMLElement>('[data-copy-svg-status]')
    void (async () => {
      const ok = await copyText(renderSvg(current?.shortUrl ?? ''))
      setState(button, status, ok ? 'ok' : 'err')
      window.setTimeout(() => setState(button, status, 'idle'), 2000)
    })()
  })
</script>
