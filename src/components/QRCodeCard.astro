---
import Button from './Button.astro'
---

<div class="qr-card">
  <div class="qr-card__box">
    <canvas class="qr-card__canvas" data-qr-canvas role="img" aria-label="Código QR del enlace"
    ></canvas>
  </div>
  <Button class="qr-card__download" variant="secondary" data-qr-download> Descargar QR </Button>
</div>

<script>
  import QRCode from 'qrcode'

  interface QrOptions {
    mode: 'short' | 'direct'
    color: string
    style: 'classic' | 'dots' | 'rounded'
    logo: boolean
    uppercase: boolean
    size: number
  }

  interface QrPayload {
    shortUrl: string
    slug: string
    qrOptions?: QrOptions
  }

  const DISPLAY_PX = 300
  const QR_MARGIN = 2
  const LOGO_RATIO = 0.24

  const canvas = document.querySelector<HTMLCanvasElement>('[data-qr-canvas]')
  const download = document.querySelector<HTMLButtonElement>('[data-qr-download]')
  let current: QrPayload | null = null

  const logoImage = new Image()
  logoImage.src = '/favicon.svg'
  void logoImage.decode().catch(() => undefined)

  function drawModule(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    unit: number,
    style: QrOptions['style'],
  ): void {
    ctx.beginPath()
    if (style === 'dots') {
      ctx.arc(x + unit / 2, y + unit / 2, unit * 0.42, 0, Math.PI * 2)
    } else if (style === 'rounded') {
      ctx.roundRect(x, y, unit, unit, unit * 0.32)
    } else {
      ctx.rect(x, y, unit, unit)
    }
    ctx.fill()
  }

  function drawLogo(ctx: CanvasRenderingContext2D, size: number): void {
    const logoSize = Math.max(16, Math.round(size * LOGO_RATIO))
    const x = (size - logoSize) / 2
    const y = (size - logoSize) / 2
    const pad = Math.round(logoSize * 0.14)

    ctx.fillStyle = '#ffffff'
    ctx.beginPath()
    ctx.roundRect(x - pad, y - pad, logoSize + pad * 2, logoSize + pad * 2, logoSize * 0.2)
    ctx.fill()

    if (logoImage.complete && logoImage.naturalWidth > 0) {
      ctx.drawImage(logoImage, x, y, logoSize, logoSize)
    }
  }

  function renderQr(text: string, options: QrOptions, pixelSize: number): HTMLCanvasElement {
    const encoded = options.uppercase ? text.toUpperCase() : text
    const qr = QRCode.create(encoded, {
      errorCorrectionLevel: options.logo ? 'H' : 'L',
    })

    const modules = qr.modules.size
    const unit = Math.floor(pixelSize / (modules + QR_MARGIN * 2))
    const size = unit * (modules + QR_MARGIN * 2)

    const target = document.createElement('canvas')
    target.width = size
    target.height = size

    const ctx = target.getContext('2d')
    if (!ctx) return target

    ctx.fillStyle = '#ffffff'
    ctx.fillRect(0, 0, size, size)
    ctx.fillStyle = options.color

    for (let row = 0; row < modules; row++) {
      for (let col = 0; col < modules; col++) {
        if (qr.modules.get(row, col)) {
          drawModule(ctx, (col + QR_MARGIN) * unit, (row + QR_MARGIN) * unit, unit, options.style)
        }
      }
    }

    if (options.logo) drawLogo(ctx, size)

    return target
  }

  window.addEventListener('shortqr:render', (event) => {
    const payload = (event as CustomEvent<QrPayload>).detail
    current = payload

    const options: QrOptions = payload.qrOptions ?? {
      mode: 'short',
      color: '#171717',
      style: 'classic',
      logo: false,
      uppercase: false,
      size: 1024,
    }

    if (!canvas) return
    const rendered = renderQr(payload.shortUrl, options, DISPLAY_PX)
    canvas.width = rendered.width
    canvas.height = rendered.height
    const ctx = canvas.getContext('2d')
    ctx?.drawImage(rendered, 0, 0)
  })

  window.addEventListener('shortqr:options', (event) => {
    const options = (event as CustomEvent<QrOptions>).detail
    if (!current || !canvas) return
    current = { ...current, qrOptions: options }
    const rendered = renderQr(current.shortUrl, options, DISPLAY_PX)
    canvas.width = rendered.width
    canvas.height = rendered.height
    canvas.getContext('2d')?.drawImage(rendered, 0, 0)
  })

  download?.addEventListener('click', () => {
    if (!current) return

    const options: QrOptions = current.qrOptions ?? {
      mode: 'short',
      color: '#171717',
      style: 'classic',
      logo: false,
      uppercase: false,
      size: 1024,
    }

    const rendered = renderQr(current.shortUrl, options, options.size)
    rendered.toBlob((blob) => {
      if (!blob) return
      const anchor = document.createElement('a')
      anchor.href = URL.createObjectURL(blob)
      anchor.download = `shortqr-${current?.slug || 'qr'}.png`
      anchor.click()
      URL.revokeObjectURL(anchor.href)
    }, 'image/png')
  })
</script>
