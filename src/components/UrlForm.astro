---
import Button from './Button.astro'
import UrlOptions from './UrlOptions.astro'
---

<form class="url-form" id="url-form" novalidate>
  <div class="url-form__row">
    <label class="sr-only" for="url-input">URL a acortar</label>
    <input
      id="url-input"
      class="url-form__input"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="Pega tu URL aquí, por ejemplo: https://ejemplo.com"
      data-url-input
    />
    <Button class="url-form__submit" type="submit" data-submit>Generar</Button>
  </div>

  <UrlOptions />

  <p class="form-error" data-form-error role="alert" hidden></p>
</form>

<script>
  interface QrOptions {
    mode: 'short' | 'direct'
  }

  interface CreatedPayload {
    shortUrl: string
    slug: string
    qrOptions?: QrOptions
  }

  interface CreateApiResponse {
    success: boolean
    shortUrl?: string
    slug?: string
    error?: string
  }

  const form = document.querySelector<HTMLFormElement>('#url-form')
  const input = document.querySelector<HTMLInputElement>('[data-url-input]')
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]')
  const error = document.querySelector<HTMLParagraphElement>('[data-form-error]')

  let options: QrOptions = { mode: 'short' }

  window.addEventListener('shortqr:options', (event) => {
    options = (event as CustomEvent<QrOptions>).detail
  })

  function showError(message: string): void {
    if (!error) return
    error.textContent = message
    error.hidden = false
  }

  function clearError(): void {
    if (!error) return
    error.hidden = true
  }

  function setLoading(loading: boolean): void {
    if (!submit) return
    submit.disabled = loading
    submit.textContent = loading ? 'Generando…' : 'Generar'
  }

  function dispatchCreated(payload: CreatedPayload): void {
    window.dispatchEvent(new CustomEvent<CreatedPayload>('shortqr:created', { detail: payload }))
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    clearError()

    const raw = input?.value.trim() ?? ''
    if (raw.length === 0) {
      showError('Escribe una URL para continuar.')
      input?.focus()
      return
    }

    let url = raw
    if (!/^https?:\/\//i.test(url)) url = `https://${url}`
    try {
      new URL(url)
    } catch {
      showError('La URL no es válida.')
      return
    }

    setLoading(true)
    try {
      if (options.mode === 'direct') {
        dispatchCreated({ shortUrl: url, slug: '', qrOptions: options })
        return
      }

      const response = await fetch('/api/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      })
      const data = (await response.json()) as CreateApiResponse

      if (!response.ok || !data.shortUrl || !data.slug) {
        showError(data.error ?? 'No se pudo crear el enlace. Intenta de nuevo.')
        return
      }

      dispatchCreated({ shortUrl: data.shortUrl, slug: data.slug, qrOptions: options })
    } catch {
      showError('No se pudo conectar con el servidor. Intenta de nuevo.')
    } finally {
      setLoading(false)
    }
  })
</script>
