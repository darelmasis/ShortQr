---
import Button from './Button.astro'
import QRCodeCard from './QRCodeCard.astro'
---

<div class="result-card">
  <div class="result-card__row">
    <a class="result-card__link" data-result-short href="#" target="_blank" rel="noreferrer"> — </a>
    <Button
      class="result-card__copy"
      variant="secondary"
      data-copy
      aria-label="Copiar enlace corto"
    >
      <span class="copy-icon">
        <svg class="copy-icon__base" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="copy-icon__ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <svg class="copy-icon__err" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </span>
      <span>Copiar</span>
      <span class="sr-only" data-copy-status aria-live="polite"></span>
    </Button>
  </div>
  <QRCodeCard />
</div>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-result-short]')
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]')
  const status = document.querySelector<HTMLSpanElement>('[data-copy-status]')

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text)
        return true
      }
    } catch {}
    try {
      const textarea = document.createElement('textarea')
      textarea.value = text
      textarea.setAttribute('readonly', '')
      textarea.style.position = 'fixed'
      textarea.style.opacity = '0'
      document.body.appendChild(textarea)
      textarea.select()
      const ok = document.execCommand('copy')
      textarea.remove()
      return ok
    } catch {
      return false
    }
  }

  function setState(state: 'idle' | 'ok' | 'err'): void {
    if (!copy) return
    copy.classList.toggle('copy-icon--ok', state === 'ok')
    copy.classList.toggle('copy-icon--err', state === 'err')
    if (status) {
      status.textContent =
        state === 'ok' ? 'Enlace copiado al portapapeles' : state === 'err' ? 'No se pudo copiar el enlace' : ''
    }
  }

  async function copyUrl(): Promise<void> {
    if (!link) return
    const ok = await copyText(link.href)
    setState(ok ? 'ok' : 'err')
    window.setTimeout(() => setState('idle'), 2000)
  }

  copy?.addEventListener('click', () => void copyUrl())
</script>
