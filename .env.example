# Cadena de conexión a MongoDB Atlas (obligatoria)
# Ejemplo: mongodb+srv://usuario:password@cluster.mongodb.net/shortqr
MONGODB_URI=

# Nombre de la base de datos (obligatoria)
MONGODB_DATABASE=shortqr

# URL base pública del sitio (dominio de producción).
# Si se omite, se usa el origin de cada request (útil en previews).
BASE_URL=

# Longitud de los slugs generados
SLUG_LENGTH=6

# --- Inicio de sesión con Google (obligatorio para crear enlaces) ---
# Crea credenciales OAuth en https://console.cloud.google.com/apis/credentials
# y añade como URI de redirección: <BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=
