---
import type { SessionUser } from '@/lib/auth'
import GoogleButton from './GoogleButton.astro'

interface Props {
  user: SessionUser | null
}

const { user } = Astro.props
---

<header class="site-header">
  <a class="brand" href="/" aria-label="ShortQR — inicio">
    <img class="brand__mark" src="/favicon.svg" alt="" width="36" height="36" />
    <span class="brand__name">ShortQR</span>
  </a>

  {
    user ? (
      <div class="site-header__user">
        {user.picture && (
          <img
            class="avatar"
            src={user.picture}
            alt=""
            width="28"
            height="28"
            referrerpolicy="no-referrer"
          />
        )}
        <span class="site-header__name">{user.name}</span>
        <form method="post" action="/api/auth/logout">
          <button class="btn btn--secondary btn--sm" type="submit">Salir</button>
        </form>
      </div>
    ) : (
      <GoogleButton compact />
    )
  }
</header>
