<div class="mode-options" role="radiogroup" aria-labelledby="options-mode-label" data-options-mode>
  <span class="mode-options__label" id="options-mode-label">Modo</span>
  <div class="segmented">
    <label>
      <input type="radio" name="qr-mode" value="short" checked />
      <span>Acortar + QR</span>
    </label>
    <label>
      <input type="radio" name="qr-mode" value="direct" />
      <span>QR directo</span>
    </label>
  </div>
</div>

<script>
  interface QrOptions {
    mode: 'short' | 'direct'
  }

  function readOptions(): QrOptions {
    return {
      mode: (document.querySelector<HTMLInputElement>('input[name="qr-mode"]:checked')
        ?.value ?? 'short') as QrOptions['mode'],
    }
  }

  document.querySelector('[data-options-mode]')?.addEventListener('change', () => {
    window.dispatchEvent(new CustomEvent<QrOptions>('shortqr:options', { detail: readOptions() }))
  })
</script>
